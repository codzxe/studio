{
  "id": "pinterest-pin",
  "version": 1,
  "name": "Pinterest Pin — Food & Lifestyle",
  "description": "A tall 2:3 food-and-lifestyle pin: a cover photo fills the top 60%, an auto-fit title of up to 50 characters sits in the cream band below, and a social-handle component row anchors the footer. §7.5 self-check: 3 slots (≤12), named layers only, nothing flattened or baked, fonts from the workspace registry with template-default palette fallback.",
  "tags": ["social", "pinterest", "pin", "food", "lifestyle"],
  "canvas": { "width": 1000, "height": 1500, "background": "#FFF7EE" },
  "slots": {
    "photo":    { "kind": "image", "layer": "Photo",    "bounds": [0, 0, 1000, 900],
                  "fit": "cover", "minPixels": [1000, 900], "optional": false },
    "title":    { "kind": "text",  "layer": "Headline", "bounds": [64, 972, 872, 216],
                  "font": "display", "weight": "bold", "size": 88, "lineHeight": 1.08,
                  "maxLines": 2, "maxChars": 50, "align": "left",
                  "color": "#3B2A20", "autoFit": { "minSize": 56, "maxSize": 104 } },
    "footer":   { "kind": "component", "component": "social-handle@1", "layer": "Footer",
                  "bounds": [64, 1380, 280, 48], "optional": true,
                  "vars": { "handle": "@acme.kitchen" } }
  },
  "rules": {
    "safeArea": 64,
    "minContrast": 4.5,
    "mustLayers": ["Background", "Photo", "Headline"],
    "maxTextLayers": 4,
    "palette": ["#FFF7EE", "#3B2A20", "#D96C3B"]
  },
  "layerMap": {
    "Background": { "role": "background", "fill": "#FFF7EE" },
    "Photo":      { "role": "image" },
    "Headline":   { "role": "headline" },
    "Footer":     { "role": "component", "component": "social-handle@1" }
  },
  "thumbnail": "thumbnails/pinterest-pin@1.png",
  "license": "public",
  "author": "studio"
}
