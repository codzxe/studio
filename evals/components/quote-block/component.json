{
  "id": "quote-block",
  "version": 1,
  "name": "Quote Block",
  "author": "studio",
  "description": "Editorial testimonial block: accent rule, display quote and attribution line.",
  "tags": ["quote", "testimonial", "editorial"],
  "defaultSize": { "width": 640, "height": 320 },
  "variables": {
    "quote":  { "kind": "text", "default": "Good coffee is a small daily celebration.", "maxChars": 280 },
    "author": { "kind": "text", "default": "Main Street Coffee", "maxChars": 48 },
    "accent": { "kind": "color", "default": "#D96C3B" }
  },
  "anchors": { "topLeft": [0, 0], "center": [0.5, 0.5], "bottomLeft": [0, 1] },
  "comps": ["default", "light", "dark"],
  "license": "public"
}
