{
  "component": "avatar-circle",
  "version": 1,
  "master": "avatar-circle@1.pcraft",
  "designSize": { "width": 96, "height": 96 },
  "group": "Avatar Circle",
  "layers": [
    {
      "name": "Avatar plate",
      "kind": "shape",
      "shape": "ellipse",
      "bounds": [0, 0, 96, 96],
      "fill": "#D96C3B",
      "defaultVisible": true,
      "binds": { "bg": "fill colour" }
    },
    {
      "name": "Initials",
      "kind": "text",
      "bounds": [8, 32, 80, 32],
      "font": "display",
      "weight": "bold",
      "size": 28,
      "lineHeight": 1.1,
      "align": "center",
      "color": "#FFF7EE",
      "defaultVisible": true,
      "binds": { "initials": "textReplacement", "textColor": "type colour" }
    }
  ],
  "bindings": {
    "initials":  { "layer": "Initials", "as": "textReplacement" },
    "bg":        { "layer": "Avatar plate", "as": "fill colour" },
    "textColor": { "layer": "Initials", "as": "type colour" }
  },
  "comps": {
    "default": "Accent plate #D96C3B with cream initials #FFF7EE.",
    "light": "Paper plate #F4E7D3 with ink initials #3B2A20.",
    "dark": "Ink plate #3B2A20 with cream initials #FFF7EE."
  }
}
