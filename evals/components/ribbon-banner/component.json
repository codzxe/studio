{
  "id": "ribbon-banner",
  "version": 1,
  "name": "Ribbon Banner",
  "author": "studio",
  "description": "Promo ribbon: centre band with folded side tails that can switch off for a plain bar.",
  "tags": ["banner", "promo", "ribbon"],
  "defaultSize": { "width": 420, "height": 96 },
  "variables": {
    "label":     { "kind": "text", "default": "NEW", "maxChars": 16 },
    "bg":        { "kind": "color", "default": "#D96C3B" },
    "textColor": { "kind": "color", "default": "#FFF7EE" },
    "corner":    { "kind": "visibility", "default": true }
  },
  "anchors": { "topLeft": [0, 0], "top": [0.5, 0], "center": [0.5, 0.5], "bottomRight": [1, 1] },
  "comps": ["default", "light", "dark"],
  "license": "public"
}
