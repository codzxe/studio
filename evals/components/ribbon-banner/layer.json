{
  "component": "ribbon-banner",
  "version": 1,
  "master": "ribbon-banner@1.pcraft",
  "designSize": { "width": 420, "height": 96 },
  "group": "Ribbon Banner",
  "layers": [
    {
      "name": "Banner tails",
      "kind": "shape",
      "shape": "path",
      "bounds": [0, 24, 420, 40],
      "fill": "#B45A2E",
      "defaultVisible": true,
      "binds": { "corner": "visibility" },
      "note": "One layer with a two-subpath path (left and right folded tails) so a single visibility variable drives both corners; corner=false leaves a plain banner bar. Authored as a darker fixed shade of the plate; comps restyle it."
    },
    {
      "name": "Banner plate",
      "kind": "shape",
      "shape": "rect",
      "bounds": [40, 12, 340, 60],
      "fill": "#D96C3B",
      "defaultVisible": true,
      "binds": { "bg": "fill colour" }
    },
    {
      "name": "Label",
      "kind": "text",
      "bounds": [40, 24, 340, 36],
      "font": "display",
      "weight": "bold",
      "size": 22,
      "lineHeight": 1.1,
      "align": "center",
      "color": "#FFF7EE",
      "defaultVisible": true,
      "binds": { "label": "textReplacement", "textColor": "type colour" }
    }
  ],
  "bindings": {
    "label":     { "layer": "Label", "as": "textReplacement" },
    "bg":        { "layer": "Banner plate", "as": "fill colour" },
    "textColor": { "layer": "Label", "as": "type colour" },
    "corner":    { "layer": "Banner tails", "as": "visibility" }
  },
  "comps": {
    "default": "Accent band #D96C3B, deep-accent tails #B45A2E, cream label #FFF7EE.",
    "light": "Paper band #F4E7D3, muted tails #6B5748, ink label #3B2A20.",
    "dark": "Ink band #3B2A20, deep tails #6B5748, cream label #FFF7EE."
  }
}
