{
  "id": "button-cta",
  "version": 1,
  "name": "Button CTA",
  "author": "studio",
  "description": "Pill CTA button: filled plate plus centred label; the plate can be hidden for a borderless text CTA.",
  "tags": ["button", "cta", "ui"],
  "defaultSize": { "width": 240, "height": 64 },
  "variables": {
    "label":     { "kind": "text", "default": "Shop now", "maxChars": 24 },
    "bg":        { "kind": "color", "default": "#D96C3B" },
    "textColor": { "kind": "color", "default": "#FFF7EE" },
    "rounded":   { "kind": "visibility", "default": true }
  },
  "anchors": { "left": [0, 0.5], "center": [0.5, 0.5], "right": [1, 0.5] },
  "comps": ["default", "light", "dark"],
  "license": "public"
}
