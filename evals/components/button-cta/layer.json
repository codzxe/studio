{
  "component": "button-cta",
  "version": 1,
  "master": "button-cta@1.pcraft",
  "designSize": { "width": 240, "height": 64 },
  "group": "Button CTA",
  "layers": [
    {
      "name": "Button plate",
      "kind": "shape",
      "shape": "roundedRect",
      "radius": 32,
      "bounds": [0, 0, 240, 64],
      "fill": "#D96C3B",
      "defaultVisible": true,
      "binds": { "bg": "fill colour", "rounded": "visibility" },
      "note": "rounded is the pill plate's visibility: true (default) renders the filled pill; false hides it for a borderless text CTA — the plate stays present but hidden (§7.3), so toggling back is lossless."
    },
    {
      "name": "CTA",
      "kind": "text",
      "bounds": [32, 16, 176, 32],
      "font": "display",
      "weight": "bold",
      "size": 24,
      "lineHeight": 1.1,
      "align": "center",
      "color": "#FFF7EE",
      "defaultVisible": true,
      "binds": { "label": "textReplacement", "textColor": "type colour" }
    }
  ],
  "bindings": {
    "label":     { "layer": "CTA", "as": "textReplacement" },
    "bg":        { "layer": "Button plate", "as": "fill colour" },
    "textColor": { "layer": "CTA", "as": "type colour" },
    "rounded":   { "layer": "Button plate", "as": "visibility" }
  },
  "comps": {
    "default": "Accent pill #D96C3B with cream label #FFF7EE.",
    "light": "Paper plate #F4E7D3 with ink label #3B2A20 (hairline outline).",
    "dark": "Ink plate #3B2A20 with cream label #FFF7EE."
  }
}
