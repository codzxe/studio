# studio-gateway.service — Studio Hono gateway (API + SSE, §7.2/§7.4).
#
# INSTALL: see infra/systemd/README.md.
# Template: adjust User/Group/WorkingDirectory/ExecStart paths to the box.
# NOTE(app-wave): @studio/gateway `start` script lands with the gateway wave;
# until then the unit starts and exits — keep it disabled on bare boxes.

[Unit]
Description=Studio — Hono gateway (API on :8787)
Documentation=https://github.com/codzxe/studio
After=network-online.target postgresql.service valkey.service
Wants=network-online.target

[Service]
Type=exec
User=studio
Group=studio
WorkingDirectory=/opt/studio
EnvironmentFile=/etc/studio/.env
Environment=NODE_ENV=production
Environment=HOME=/opt/studio
ExecStart=/usr/bin/pnpm --filter @studio/gateway start
Restart=always
RestartSec=3

# ── hardening (§15.2) ─────────────────────────────────────────────────────────
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/studio/.local
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# NOTE: deny JIT write-exec only if the runtime allows it; Node/V8 needs W+X for
# JIT pages on x64 — keep MemoryDenyWriteExecute commented for Node services.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
