# studio-web.service — Studio Next.js SaaS shell (native/systemd path, §14.2).
#
# INSTALL: see infra/systemd/README.md.
# Template: adjust User/Group/WorkingDirectory/ExecStart paths to the box.

[Unit]
Description=Studio — Next.js web app (SaaS shell)
Documentation=https://github.com/codzxe/studio
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=studio
Group=studio
WorkingDirectory=/opt/studio
# 34-var app contract (chmod 600 root:studio, see README).
EnvironmentFile=/etc/studio/.env
Environment=NODE_ENV=production
# Node needs a writable HOME for corepack/v8 caches.
Environment=HOME=/opt/studio
ExecStart=/usr/bin/pnpm --filter @studio/web start
Restart=always
RestartSec=3

# ── hardening (§15.2) ─────────────────────────────────────────────────────────
NoNewPrivileges=yes
ProtectSystem=strict
# The app writes only under its own .local (logs, tmp state) in this template.
ReadWritePaths=/opt/studio/.local
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# NOTE: Node/V8 needs writable+executable JIT pages — MemoryDenyWriteExecute
# must stay OFF for Node services.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
