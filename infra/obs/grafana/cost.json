{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["studio", "cost", "w9-f"],
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "utc",
  "title": "studio — Cost (§22: per-workspace spend, top spenders, COGS)",
  "uid": "studio-cost",
  "version": 1,
  "description": "Cost dashboard — spec §22 and §18.2. Series names are the canonical registry in infra/obs/README.md; emitted by packages/agent/src/obs/metrics.ts (W9-D).",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Per-workspace spend — top 10 (24h)",
      "description": "Trailing-24h AI spend per workspace, highest first (§22 cost: per-workspace spend, top spenders; guardrails §18.2). Series: studio_ai_cost_usd_total{workspace} (worker §22 collector, W10-E-aligned; label is `workspace`).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "align": "auto" }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "enablePagination": true }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "topk(10, sort_desc(sum by (workspace) (increase(studio_ai_cost_usd_total[24h]))))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tokens by model (input / output / cache read)",
      "description": "Token flow per model and direction (§22 tokens in/out/cache) — driver of per-model COGS. Series: studio_ai_tokens_total{model, direction} (worker §22 collector, W10-E-aligned).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum by (model, direction) (rate(studio_ai_tokens_total[5m]))",
          "legendFormat": "{{model}} · {{direction}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "COGS ratio (AI spend / MRR) — budget ≤ 25% (§1.5-7)",
      "description": "ANNOTATED THRESHOLD — §1.5-7 'Cost discipline: AI COGS ≤ 25% of revenue'; §18.2 keep COGS ≤ 25% of revenue. Red marker at 0.25. Ratio = trailing-30d AI spend ÷ MRR: sum(increase(studio_ai_cost_usd_total[30d])) / studio_billing_mrr_usd (MRR is the manual-input placeholder — see business dashboard + README).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 0.5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum(increase(studio_ai_cost_usd_total[30d])) / scalar(max(studio_billing_mrr_usd))",
          "legendFormat": "COGS ratio",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "AI cost — daily accumulation vs budget",
      "description": "Trailing-24h AI cost against the daily budget gauge studio_daily_cost_budget_usd (from DAILY_BUDGET_USD config). Breach fires StudioDailyCostOverBudget → RB-08 (§22). Series: studio_ai_cost_usd_total.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum(increase(studio_ai_cost_usd_total[24h]))",
          "legendFormat": "AI cost (24h)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "scalar(max(studio_daily_cost_budget_usd))",
          "legendFormat": "daily budget",
          "range": true,
          "refId": "B"
        }
      ]
    }
  ]
}
