{
  "name": "@studio/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Studio gateway: Hono API \u2014 auth, workspaces, projects/versions/leases/assets, threads, SSE chat skeleton, credits, billing, storage (PRODUCT_ARCHITECTURE \u00a77).",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./storage": "./src/storage.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@studio/config": "workspace:*",
    "@studio/contracts": "workspace:*",
    "@studio/db": "workspace:*",
    "@studio/storage": "workspace:*",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
