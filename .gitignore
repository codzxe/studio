# dependencies / build artifacts
node_modules/
dist/
build/
.next/
out/
.turbo/
coverage/
*.tsbuildinfo

# env & secrets
.env
.env.*
!.env.example

# logs & os
*.log
.DS_Store

# fonts are NEVER committed (spec §1.5 rule 9) — they come from CRAFT_FONTS_DIR
*.ttf
*.otf
*.woff
*.woff2
fonts/

# rust artifacts (engine-patches are source-only)
target/

# heavy binary assets — outputs go to object storage, not git
*.pcraft
!evals/fixtures/**/*.pcraft
*.psd
*.psb

# local demo artifacts (apps/worker/.demo-output/ from demo:coffee / demo:spine)
# — never tracked; git-sync's `add -A` must not sweep them (W10-T hygiene)
.demo-output/

# editor misc
.idea/
.vscode/

# editor wasm build output (built by cargo xtask web, never committed)
editor/target/
editor/dist/
# rust tooling
editor/rustc-*.json

# portable local services (native dev without Docker)
.local/

# Fonts are NEVER committed (spec §1.5 rule 9, AGENTS.md, ADR-0001): binaries are
# consumed at build time from the pinned craft-fonts clone via CRAFT_FONTS_DIR.
# W3-C4 untracked the vendored bundle (7 .ttf + .attribution + OFL texts) — physical
# files stay on disk for editor builds (crates/text/src/fonts.rs include_bytes!),
# so ignore the whole directory; the old negation below re-included it into git.
editor/assets/fonts/

# local reference clone for editor patch/pin work — never tracked (phantom
# submodule removed W5-hygiene: fresh clones get editor/ only, which is the
# self-contained vendored source per D-17)
/effectcraft-upstream/

# Stale tsc-emit artifacts (M9 recovery): these packages ship TS source only
# (`main: ./src/index.ts`); committed .js/.js.map/.d.ts shadow the .ts at
# runtime via tsx's explicit ".js" resolution and caused the W1 countActive
# 500s. Never commit compiled output for source-only packages.
packages/config/src/**/*.js
packages/config/src/**/*.js.map
packages/config/src/**/*.d.ts
packages/contracts/src/**/*.js
packages/contracts/src/**/*.js.map
packages/contracts/src/**/*.d.ts
packages/db/src/**/*.js
packages/db/src/**/*.js.map
packages/db/src/**/*.d.ts
# W4-KILL (stub audit KILL-1/KILL-2): the 1989de5 add -A sweep committed 18
# more of these into editor-bridge/storage src (storage/validate.js was even
# load-bearing through a relative .js import — fixed via the @studio/storage
# dependency seam). The wildcard below keeps the sweep out of EVERY
# source-only package, so git-sync add -A can never bring them back.
packages/editor-bridge/src/**/*.js
packages/editor-bridge/src/**/*.js.map
packages/editor-bridge/src/**/*.d.ts
packages/storage/src/**/*.js
packages/storage/src/**/*.js.map
packages/storage/src/**/*.d.ts
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts

# repo purge (W1-01, user order 2026-10-23): these trees were deleted; the ignore
# rules stay so nothing resurrects or re-commits them. Content lives in git
# history only (`git log --oneline -- archive/`).
/archive/
/agent-ctx/
# session scratch that regenerates constantly — committed once, purged in 59ef2d7,
# came back; NEVER let it in again
/tool-results/
# git-sync.sh flock target — runtime artifact, never commit
/.studio-git.lock
# push credential file — never tracked (docs/secrets-policy.md §1: secrets live
# only in 0600 env files). Untracked by W1-01; history scrub + rotation owed to
# the platform owner.
/.github-token

# repo purge round 2 (W3-B, user order 2026-10-23): these trees stay on disk
# (skills/ is the LIVE agent harness) but are never repo content. upload/ and
# download/ are reproducible session paste/deliverable dirs; bun.lock is bun
# contamination (repo is pnpm-only — pnpm-lock.yaml + pnpm-workspace.yaml).
/skills/
/upload/
/download/
/bun.lock

# session junk from tool calls — never commit
/tool-results/
/.local/

# W1-A3 junk purge (2026-10-23): backup-file extensions never belong in git
*.bak
*.orig

# W1-A3: Playwright run artifacts (outputDir per apps/web/playwright.config.ts)
# — regenerable test output, untracked 2026-10-23 (97 files, ~20MB). Deliberately
# the ONLY apps/ path ignored; kept on disk (hard rule: never rm under apps/).
/apps/web/e2e/.results/
/db/
.vercel
.env
.env.*
!.env.example
