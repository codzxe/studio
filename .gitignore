# dependencies / build artifacts
node_modules/
dist/
build/
.next/
out/
.turbo/
coverage/
*.tsbuildinfo

# env & secrets
.env
.env.*
!.env.example

# logs & os
*.log
.DS_Store

# fonts are NEVER committed (spec §1.5 rule 9) — they come from CRAFT_FONTS_DIR
*.ttf
*.otf
*.woff
*.woff2
fonts/

# rust artifacts (engine-patches are source-only)
target/

# heavy binary assets — outputs go to object storage, not git
*.pcraft
!evals/fixtures/**/*.pcraft
*.psd
*.psb

# local demo artifacts (apps/worker/.demo-output/ from demo:coffee / demo:spine)
# — never tracked; git-sync's `add -A` must not sweep them (W10-T hygiene)
.demo-output/

# editor misc
.idea/
.vscode/

# editor wasm build output (built by cargo xtask web, never committed)
editor/target/
editor/dist/
# rust tooling
editor/rustc-*.json

# portable local services (native dev without Docker)
.local/

# Vendored EffectCraft bundles SIL OFL 1.1 fonts (upstream assets, with .attribution files).
# Required at build time by crates/text/src/fonts.rs include_bytes! — see D-17, editor/UPSTREAM.md
!editor/assets/fonts/
!editor/assets/fonts/**
