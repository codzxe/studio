{
    "extends": "../../tsconfig.base.json",
    // Fleet normalization (W2-Q): NO explicit rootDir (was "src" → TS6059 on
    // tests/). This package's program also pulls sibling workspace SOURCES via
    // imports (@studio/config/@studio/db resolve to src/*.ts through pnpm links),
    // and an explicit rootDir — "src" or "." — would trip TS6059 on those files.
    // tsc infers the common root across src/, tests/ and the imported sources.
    "compilerOptions": { "outDir": "dist", "jsx": "preserve" },
    "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"]
  }
