{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["plan", "run"],
  "additionalProperties": false,
  "properties": {
    "plan": {
      "type": "object",
      "required": ["intent", "template", "assets", "slots", "palette", "typography", "steps", "checks", "model_tier", "notes_for_user"],
      "additionalProperties": false,
      "properties": {
        "intent": { "enum": ["create_post", "edit_layers", "resize", "variant", "export"] },
        "template": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*@\\d+$" },
            { "type": "null" }
          ]
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "slot"],
            "additionalProperties": false,
            "properties": {
              "ref": { "type": "string", "minLength": 1 },
              "slot": { "type": "string", "minLength": 1 },
              "fit": { "enum": ["cover", "contain", "fill"] },
              "focal": {
                "type": "object",
                "required": ["x", "y"],
                "additionalProperties": false,
                "properties": {
                  "x": { "type": "number", "minimum": 0, "maximum": 1 },
                  "y": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        },
        "slots": { "type": "object", "additionalProperties": { "type": "string" } },
        "palette": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        },
        "typography": { "type": "object" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tool", "args"],
            "additionalProperties": false,
            "properties": {
              "tool": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]*(\\.[a-zA-Z0-9_]+)*$" },
              "args": { "type": "object" }
            }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "model_tier": { "enum": ["quick", "standard", "complex"] },
        "notes_for_user": { "type": "string", "maxLength": 300 }
      }
    },
    "run": {
      "type": "object",
      "required": ["status", "credits_charged", "tool_calls", "revisions", "validator", "layers", "undo_entries", "rolled_back", "reservation_released"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["succeeded", "succeeded_with_warnings", "failed"] },
        "credits_charged": { "type": "number", "minimum": 0, "maximum": 20 },
        "tool_calls": { "type": "integer", "minimum": 0, "maximum": 24 },
        "revisions": { "type": "integer", "minimum": 0, "maximum": 3 },
        "code": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "retryable": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] },
        "retry_grace": { "type": "integer", "minimum": 0 },
        "validator": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["ok", "blockers", "majors", "minors"],
              "additionalProperties": false,
              "properties": {
                "ok": { "type": "boolean" },
                "blockers": { "type": "integer", "minimum": 0 },
                "majors": { "type": "integer", "minimum": 0 },
                "minors": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        },
        "layers": { "type": "array", "items": { "type": "string" } },
        "undo_entries": { "type": "integer", "minimum": 0, "maximum": 1 },
        "rolled_back": { "type": "boolean" },
        "reservation_released": { "type": "boolean" }
      }
    }
  }
}
