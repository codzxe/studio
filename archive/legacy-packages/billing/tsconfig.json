{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
      // Fleet normalization (W2-Q): NO rootDir/outDir. tests/ sit next to src/
      // and the program pulls sibling workspace SOURCES via imports
      // (@studio/config/@studio/db resolve to src/*.ts through pnpm links), so
      // an explicit rootDir would trip TS6059. tsc infers the common root;
      // `tsc --noEmit` is the gate (fleet precedent — apps/worker, apps/gateway).
      "noEmit": true
    },
    "include": ["src/**/*.ts", "tests/**/*.ts"]
  }
