{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["studio", "business", "w9-f"],
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "utc",
  "title": "studio — Business (§22: MRR, customers, credits burned, COGS ratio)",
  "uid": "studio-business",
  "version": 1,
  "description": "Business dashboard — spec §22. Series names are the canonical registry in infra/obs/README.md; emitted by packages/agent/src/obs/metrics.ts (W9-D) and the billing sync placeholders.",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "MRR (USD) — PLACEHOLDER, manual input",
      "description": "PLACEHOLDER — manual input until the Stripe reconciliation job publishes this gauge. MRR = monthly recurring revenue. Update procedure (1st of each month): POST to the pushgateway `billing-manual` job — see infra/obs/README.md § 'Manual MRR input'. Series: studio_billing_mrr_usd.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "max(studio_billing_mrr_usd)",
          "legendFormat": "MRR",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Customers (active subscriptions)",
      "description": "Workspaces with an active paid subscription. Sync placeholder gauge published by the billing sync job (see infra/obs/README.md). Series: studio_customers_total.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "max(studio_customers_total)",
          "legendFormat": "customers",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "COGS ratio (AI spend / MRR) — budget ≤ 25%",
      "description": "AI COGS ratio = trailing-30d AI spend ÷ MRR. Budget threshold: ≤ 25% of revenue (§1.5-7 'Cost discipline: AI COGS ≤ 25% of revenue'; §18.2). Red above 0.25. Series: sum(increase(studio_ai_cost_usd_total[30d])) / studio_billing_mrr_usd (MRR placeholder, manual input).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 0.5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum(increase(studio_ai_cost_usd_total[30d])) / scalar(max(studio_billing_mrr_usd))",
          "legendFormat": "COGS ratio",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Credits burned (committed) vs reserved",
      "description": "Credit ledger flow (§5.2): committed = burned by finished runs; reserved = held by in-flight runs. Series: studio_credits_committed_total, studio_credits_reserved_total (rates, 5m).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum(rate(studio_credits_committed_total[5m]))",
          "legendFormat": "committed (burned)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum(rate(studio_credits_reserved_total[5m]))",
          "legendFormat": "reserved",
          "range": true,
          "refId": "B"
        }
      ]
    }
  ]
}
