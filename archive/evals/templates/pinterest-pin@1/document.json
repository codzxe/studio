{
  "format": "studio-template-document/1",
  "template": "pinterest-pin@1",
  "name": "Pinterest Pin — Food & Lifestyle",
  "width": 1000,
  "height": 1500,
  "background": "#FFF7EE",
  "layers": [
    {
      "name": "Background",
      "kind": "Fill",
      "bounds": [0, 0, 1000, 1500],
      "visible": true,
      "opacity": 1.0,
      "fill": "#FFF7EE"
    },
    {
      "name": "Photo",
      "kind": "Pixel",
