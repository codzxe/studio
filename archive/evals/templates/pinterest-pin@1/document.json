      "kind": "Type",
      "bounds": [64, 972, 872, 216],
      "visible": true,
      "opacity": 1.0,
      "text": {
        "content": "One-pan lemon garlic dinner",
        "font": "display",
        "weight": "bold",
        "size": 88,
        "lineHeight": 1.08,
        "color": "#3B2A20",
        "align": "left"
      }
    },
    {
      "name": "Footer",
      "kind": "Group",
      "bounds": [64, 1380, 280, 48],
      "visible": true,
      "opacity": 1.0,
      "component": {
        "id": "social-handle@1",
        "vars": { "handle": "@acme.kitchen" }
      }
    }
  ]
}
