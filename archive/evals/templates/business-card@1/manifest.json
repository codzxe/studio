{
  "id": "business-card",
  "version": 1,
  "name": "Business Card — Standard",
  "description": "A standard 3.5×2 in business card at 300 dpi with a 3 mm print-bleed allowance (1063×652 px canvas): logo, name, title, contact block and a recolourable accent band.",
  "tags": ["print", "card", "business"],
  "canvas": { "width": 1063, "height": 652, "background": "#F4E7D3" },
  "slots": {
    "name":    { "kind": "text", "layer": "Headline", "bounds": [178, 170, 700, 96],
                 "font": "display", "weight": "bold", "size": 84, "lineHeight": 1.1,
                 "maxLines": 1, "maxChars": 24, "align": "left",
                 "color": "#3B2A20", "autoFit": { "minSize": 56, "maxSize": 90 } },
    "title":   { "kind": "text", "layer": "Subhead", "bounds": [178, 286, 700, 56],
                 "font": "sans", "size": 44, "maxLines": 1, "maxChars": 32, "align": "left",
                 "color": "#6B5748", "autoFit": { "minSize": 36, "maxSize": 44 } },
    "contact": { "kind": "text", "layer": "Body", "bounds": [178, 420, 700, 150],
                 "font": "sans", "size": 36, "lineHeight": 1.3, "maxLines": 3, "maxChars": 108,
                 "align": "left", "color": "#6B5748" },
    "logo":    { "kind": "image", "layer": "Logo", "bounds": [783, 60, 220, 80],
                 "fit": "contain", "optional": true },
    "accent":  { "kind": "color", "layer": "Accent Band", "color": "#D96C3B", "optional": true }
  },
  "rules": {
    "safeArea": 60,
    "minContrast": 4.5,
    "mustLayers": ["Background", "Headline"],
    "maxTextLayers": 4,
    "palette": ["#F4E7D3", "#3B2A20", "#6B5748", "#D96C3B"]
  },
  "layerMap": {
    "Background":  { "role": "background", "fill": "#F4E7D3" },
    "Accent Band": { "role": "decoration", "fill": "#D96C3B" },
    "Headline":    { "role": "headline" },
    "Subhead":     { "role": "subhead" },
    "Body":        { "role": "body" },
    "Logo":        { "role": "logo" }
  },
  "thumbnail": "thumbnails/business-card@1.png",
  "license": "public",
  "author": "studio"
}
