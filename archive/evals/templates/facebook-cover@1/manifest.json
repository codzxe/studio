{
  "id": "facebook-cover",
  "version": 1,
  "name": "Facebook Cover — Photo",
  "description": "A wide 820×312 page cover: a full-bleed cover photo, a left-safe headline that survives the mobile crop, and an optional top-left logo. §7.5 self-check: 3 slots (≤12), named layers only, no hidden pixel dumps or flattened art, fonts from the workspace registry with template-default palette fallback.",
  "tags": ["social", "facebook", "cover", "wide"],
  "canvas": { "width": 820, "height": 312, "background": "#101418" },
  "slots": {
    "photo":    { "kind": "image", "layer": "Photo",    "bounds": [0, 0, 820, 312],
                  "fit": "cover", "minPixels": [820, 312], "optional": false },
    "headline": { "kind": "text",  "layer": "Headline", "bounds": [48, 132, 524, 96],
                  "font": "display", "weight": "bold", "size": 60, "lineHeight": 1.05,
                  "maxLines": 2, "maxChars": 48, "align": "left",
                  "color": "#FFFFFF", "autoFit": { "minSize": 36, "maxSize": 72 } },
    "logo":     { "kind": "image", "layer": "Logo",     "bounds": [48, 48, 64, 64],
                  "fit": "contain", "optional": true }
  },
  "rules": {
    "safeArea": 48,
    "minContrast": 4.5,
    "mustLayers": ["Background", "Photo", "Headline"],
    "maxTextLayers": 2,
    "palette": ["#101418", "#FFFFFF", "#D96C3B"]
  },
  "layerMap": {
    "Background": { "role": "background", "fill": "#101418" },
    "Photo":      { "role": "image" },
    "Headline":   { "role": "headline" },
    "Logo":       { "role": "logo" }
  },
  "thumbnail": "thumbnails/facebook-cover@1.png",
  "license": "public",
  "author": "studio"
}
