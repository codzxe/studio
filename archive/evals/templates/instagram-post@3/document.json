    {
      "name": "Headline",
      "kind": "Type",
      "bounds": [72, 732, 936, 176],
      "visible": true,
      "opacity": 1.0,
      "text": {
        "content": "Summer launch",
        "font": "display",
        "weight": "bold",
        "size": 96,
        "lineHeight": 1.05,
        "color": "#3B2A20",
        "align": "left"
      }
    },
    {
      "name": "Subhead",
      "kind": "Type",
      "bounds": [72, 924, 936, 56],
      "visible": true,
      "opacity": 1.0,
      "text": {
        "content": "New season, new colours",
        "font": "sans",
        "size": 36,
        "color": "#6B5748",
        "align": "left"
      }
    },
    {
      "name": "Badge",
      "kind": "Group",
      "bounds": [828, 72, 180, 180],
      "visible": true,
      "opacity": 1.0,
      "component": {
        "id": "offer-badge@2",
        "vars": { "label": "20% OFF" }
