    },
    {
      "name": "Logo",
      "kind": "Pixel",
      "bounds": [888, 984, 120, 40],
      "visible": true,
      "opacity": 1.0,
      "placeholder": "logo placeholder — synthetic wordmark gradient PNG (see assets-note.md); optional slot stays present but hidden when unfilled"
    }
  ]
}
