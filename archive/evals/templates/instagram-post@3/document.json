      "bounds": [0, 0, 1080, 1080],
      "visible": true,
      "opacity": 1.0,
      "fill": "#F4E7D3"
    },
    {
      "name": "Photo",
      "kind": "Pixel",
      "bounds": [0, 0, 1080, 700],
      "visible": true,
      "opacity": 1.0,
      "placeholder": "photo placeholder — synthetic gradient PNG (see assets-note.md); replaced by the placed image on template.fill, never deleted"
