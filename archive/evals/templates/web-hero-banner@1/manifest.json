{
  "id": "web-hero-banner",
  "version": 1,
  "name": "Web Hero Banner — Crop-Safe",
  "description": "A 1920×1080 landing hero, crop-safe: the headline, subhead and CTA sit inside the visible central 1920×600 band (y 240–840) so a middle-band CMS crop keeps the copy; a cover photo fills the right half.",
  "tags": ["web", "hero", "banner", "landing", "16x9"],
  "canvas": { "width": 1920, "height": 1080, "background": "#101418" },
  "slots": {
    "photo":    { "kind": "image",     "layer": "Photo", "bounds": [960, 0, 960, 1080],
                  "fit": "cover", "minPixels": [960, 1080], "focal": [0.5, 0.5],
                  "optional": false },
    "headline": { "kind": "text",      "layer": "Headline", "bounds": [96, 320, 744, 240],
                  "font": "display", "weight": "bold", "size": 104, "lineHeight": 1.05,
                  "maxLines": 2, "maxChars": 40, "align": "left",
                  "color": "#FFF7EE", "autoFit": { "minSize": 64, "maxSize": 120 } },
    "subhead":  { "kind": "text",      "layer": "Subhead", "bounds": [96, 592, 640, 104],
                  "font": "sans", "size": 40, "lineHeight": 1.3,
                  "maxLines": 2, "maxChars": 90, "align": "left",
                  "color": "#F4E7D3" },
    "cta":      { "kind": "component", "component": "button-cta@1", "layer": "CTA Button",
                  "bounds": [96, 728, 240, 64], "optional": false,
                  "vars": { "label": "Start free trial", "bg": "#FFF7EE",
                            "textColor": "#101418", "rounded": true } }
  },
  "rules": {
    "safeArea": 96,
    "minContrast": 4.5,
    "mustLayers": ["Background", "Photo", "Headline", "CTA Button"],
    "maxTextLayers": 4,
    "palette": ["#101418", "#FFF7EE", "#F4E7D3", "#6B5748"]
  },
  "layerMap": {
    "Background": { "role": "background", "fill": "#101418" },
    "Photo":      { "role": "photo" },
    "Headline":   { "role": "headline" },
    "Subhead":    { "role": "subhead" },
    "CTA Button": { "role": "component", "component": "button-cta@1" }
  },
  "thumbnail": "thumbnails/web-hero-banner@1.png",
  "license": "public",
  "author": "studio"
}
