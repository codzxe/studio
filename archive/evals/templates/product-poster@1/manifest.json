{
  "id": "product-poster",
  "version": 1,
  "name": "Product Poster — A4",
  "description": "A4 product poster (2480×3508 px at 300 dpi, 210×297 mm) with a giant auto-fit headline, subhead, centred product photo and a price-tag component.",
  "tags": ["print", "poster", "a4", "product"],
  "canvas": { "width": 2480, "height": 3508, "background": "#F4E7D3" },
  "slots": {
    "headline": { "kind": "text", "layer": "Headline", "bounds": [200, 240, 2080, 600],
                  "font": "display", "weight": "bold", "size": 280, "lineHeight": 1.02,
                  "maxLines": 2, "maxChars": 20, "align": "center",
                  "color": "#3B2A20", "autoFit": { "minSize": 160, "maxSize": 280 } },
    "subhead":  { "kind": "text", "layer": "Subhead", "bounds": [200, 880, 2080, 180],
                  "font": "sans", "size": 72, "maxLines": 2, "maxChars": 90, "align": "center",
                  "color": "#6B5748" },
    "photo":    { "kind": "image", "layer": "Photo", "bounds": [440, 1120, 1600, 1600],
                  "fit": "cover", "minPixels": [1600, 1600], "focal": [0.5, 0.5], "optional": false },
    "price":    { "kind": "component", "component": "price-tag@1", "layer": "Price Tag",
                  "bounds": [1050, 3060, 380, 228], "optional": true,
                  "vars": { "price": "129", "currency": "$" } }
  },
  "rules": {
    "safeArea": 200,
    "minContrast": 4.5,
    "mustLayers": ["Background", "Photo", "Headline"],
    "maxTextLayers": 4,
    "palette": ["#F4E7D3", "#3B2A20", "#6B5748", "#FFF7EE"]
  },
  "layerMap": {
    "Background": { "role": "background", "fill": "#F4E7D3" },
    "Photo":      { "role": "image" },
    "Headline":   { "role": "headline" },
    "Subhead":    { "role": "supporting-text" },
    "Price Tag":  { "role": "component", "component": "price-tag@1" }
  },
  "thumbnail": "thumbnails/product-poster@1.png",
  "license": "public",
  "author": "studio"
}
