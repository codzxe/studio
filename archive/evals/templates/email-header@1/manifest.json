{
  "id": "email-header",
  "version": 1,
  "name": "Email Header — Announcement",
  "description": "A 1200×400 email banner: logo left, centred headline, CTA button, on a soft cream-to-paper vertical gradient (base #FFF7EE — the gradient is the documented paint.gradient note in assets-note.md, not a slot).",
  "tags": ["email", "header", "banner", "cta"],
  "canvas": { "width": 1200, "height": 400, "background": "#FFF7EE" },
  "slots": {
    "logo":     { "kind": "image",     "layer": "Logo", "bounds": [64, 160, 160, 80],
                  "fit": "contain", "optional": false },
    "headline": { "kind": "text",      "layer": "Headline", "bounds": [288, 100, 560, 200],
                  "font": "display", "weight": "bold", "size": 64, "lineHeight": 1.1,
                  "maxLines": 2, "maxChars": 50, "align": "left",
                  "color": "#3B2A20", "autoFit": { "minSize": 36, "maxSize": 72 } },
    "cta":      { "kind": "component", "component": "button-cta@1", "layer": "CTA Button",
                  "bounds": [900, 168, 240, 64], "optional": false,
                  "vars": { "label": "Read the story", "bg": "#3B2A20",
                            "textColor": "#FFF7EE", "rounded": true } }
  },
  "rules": {
    "safeArea": 48,
    "minContrast": 4.5,
    "mustLayers": ["Background", "Headline", "CTA Button"],
    "maxTextLayers": 3,
    "palette": ["#FFF7EE", "#F4E7D3", "#3B2A20", "#6B5748"]
  },
  "layerMap": {
    "Background": { "role": "background", "fill": "#FFF7EE" },
    "Logo":       { "role": "logo" },
    "Headline":   { "role": "headline" },
    "CTA Button": { "role": "component", "component": "button-cta@1" }
  },
  "thumbnail": "thumbnails/email-header@1.png",
  "license": "public",
  "author": "studio"
}
