{
  "id": "cafe-menu",
  "version": 1,
  "name": "Café Menu — Table Card",
  "description": "A landscape café table card (1063×652 px, ~3.5×2 in at 300 dpi): centred header, two item-block groups with 3 menu items each, prices via the workspace data set. Menu items are 2 text slots (name + price) per item — a full data-set page drives 4 items per column block; this starter ships 6 name slots (8 slots total, within §7.5's ~12). Price text layers are document layers, not template slots.",
  "tags": ["print", "menu", "cafe", "landscape"],
  "canvas": { "width": 1063, "height": 652, "background": "#FFF7EE" },
  "slots": {
    "header": { "kind": "text", "layer": "Headline", "bounds": [60, 60, 943, 90],
                "font": "display", "weight": "bold", "size": 64, "maxLines": 1, "maxChars": 30,
                "align": "center", "color": "#3B2A20", "autoFit": { "minSize": 44, "maxSize": 68 } },
    "item1":  { "kind": "text", "layer": "Item 1 — Name", "bounds": [60, 200, 300, 48],
                "font": "sans", "size": 40, "maxLines": 1, "maxChars": 18, "align": "left",
                "color": "#3B2A20", "autoFit": { "minSize": 28, "maxSize": 40 } },
    "item2":  { "kind": "text", "layer": "Item 2 — Name", "bounds": [60, 328, 300, 48],
                "font": "sans", "size": 40, "maxLines": 1, "maxChars": 18, "align": "left",
                "color": "#3B2A20", "autoFit": { "minSize": 28, "maxSize": 40 } },
    "item3":  { "kind": "text", "layer": "Item 3 — Name", "bounds": [60, 456, 300, 48],
                "font": "sans", "size": 40, "maxLines": 1, "maxChars": 18, "align": "left",
                "color": "#3B2A20", "autoFit": { "minSize": 28, "maxSize": 40 } },
    "item4":  { "kind": "text", "layer": "Item 4 — Name", "bounds": [593, 200, 300, 48],
                "font": "sans", "size": 40, "maxLines": 1, "maxChars": 18, "align": "left",
                "color": "#3B2A20", "autoFit": { "minSize": 28, "maxSize": 40 } },
    "item5":  { "kind": "text", "layer": "Item 5 — Name", "bounds": [593, 328, 300, 48],
                "font": "sans", "size": 40, "maxLines": 1, "maxChars": 18, "align": "left",
                "color": "#3B2A20", "autoFit": { "minSize": 28, "maxSize": 40 } },
    "item6":  { "kind": "text", "layer": "Item 6 — Name", "bounds": [593, 456, 300, 48],
                "font": "sans", "size": 40, "maxLines": 1, "maxChars": 18, "align": "left",
                "color": "#3B2A20", "autoFit": { "minSize": 28, "maxSize": 40 } },
    "logo":   { "kind": "image", "layer": "Logo", "bounds": [471, 548, 120, 40],
                "fit": "contain", "optional": true }
  },
  "rules": {
    "safeArea": 60,
    "minContrast": 4.5,
    "mustLayers": ["Background", "Headline"],
    "maxTextLayers": 14,
    "palette": ["#FFF7EE", "#3B2A20", "#6B5748"]
  },
  "layerMap": {
    "Background":         { "role": "background", "fill": "#FFF7EE" },
    "Headline":           { "role": "headline" },
    "Item Block — Left":  { "role": "group" },
    "Item Block — Right": { "role": "group" },
    "Item 1 — Name":      { "role": "menu-item" },
    "Item 1 — Price":     { "role": "menu-price" },
    "Item 2 — Name":      { "role": "menu-item" },
    "Item 2 — Price":     { "role": "menu-price" },
    "Item 3 — Name":      { "role": "menu-item" },
    "Item 3 — Price":     { "role": "menu-price" },
    "Item 4 — Name":      { "role": "menu-item" },
    "Item 4 — Price":     { "role": "menu-price" },
    "Item 5 — Name":      { "role": "menu-item" },
    "Item 5 — Price":     { "role": "menu-price" },
    "Item 6 — Name":      { "role": "menu-item" },
    "Item 6 — Price":     { "role": "menu-price" },
    "Logo":               { "role": "logo" }
  },
  "thumbnail": "thumbnails/cafe-menu@1.png",
  "license": "public",
  "author": "studio"
}
