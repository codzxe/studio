{
  "id": "presentation-quote",
  "version": 1,
  "name": "Presentation Slide — Quote",
  "description": "A 1920×1080 keynote quote slide: a giant auto-fit quote, an attribution line and a wave divider on a minimal cream-and-ink palette.",
  "tags": ["presentation", "quote", "slide", "16x9", "minimal"],
  "canvas": { "width": 1920, "height": 1080, "background": "#FFF7EE" },
  "slots": {
    "quote":       { "kind": "text", "layer": "Quote", "bounds": [160, 168, 1600, 528],
                    "font": "display", "size": 112, "lineHeight": 1.15,
                    "maxLines": 4, "maxChars": 140, "align": "left",
                    "color": "#3B2A20", "autoFit": { "minSize": 72, "maxSize": 144 } },
    "attribution": { "kind": "text", "layer": "Attribution", "bounds": [160, 744, 1400, 64],
                    "font": "sans", "size": 40, "maxLines": 1, "maxChars": 90, "align": "left",
                    "color": "#6B5748" },
    "divider":     { "kind": "component", "component": "wave-divider@1", "layer": "Wave Divider",
                    "bounds": [160, 848, 900, 120], "optional": false,
                    "vars": { "color": "#3B2A20", "flip": false } }
  },
  "rules": {
    "safeArea": 96,
    "minContrast": 4.5,
    "mustLayers": ["Background", "Quote", "Attribution", "Wave Divider"],
    "maxTextLayers": 4,
    "palette": ["#FFF7EE", "#3B2A20", "#6B5748"]
  },
  "layerMap": {
    "Background":   { "role": "background", "fill": "#FFF7EE" },
    "Quote":        { "role": "quote" },
    "Attribution":  { "role": "attribution" },
    "Wave Divider": { "role": "component", "component": "wave-divider@1" }
  },
  "thumbnail": "thumbnails/presentation-quote@1.png",
  "license": "public",
  "author": "studio"
}
