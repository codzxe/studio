{
  "id": "star-rating",
  "version": 1,
  "name": "Star Rating",
  "author": "studio",
  "description": "Compact rating row: up to three star glyphs (or a short value such as 4.5) in the brand colour.",
  "tags": ["rating", "social-proof"],
  "defaultSize": { "width": 240, "height": 48 },
  "variables": {
    "stars": { "kind": "text", "default": "★★★", "maxChars": 3 },
    "color": { "kind": "color", "default": "#D96C3B" }
  },
  "anchors": { "left": [0, 0.5], "center": [0.5, 0.5], "right": [1, 0.5] },
  "comps": ["default", "light", "dark"],
  "license": "public"
}
