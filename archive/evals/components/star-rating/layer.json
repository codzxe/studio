{
  "component": "star-rating",
  "version": 1,
  "master": "star-rating@1.pcraft",
  "designSize": { "width": 240, "height": 48 },
  "group": "Star Rating",
  "layers": [
    {
      "name": "Rating",
      "kind": "text",
      "bounds": [0, 10, 240, 28],
      "font": "display",
      "weight": "bold",
      "size": 24,
      "lineHeight": 1.1,
      "align": "start",
      "color": "#D96C3B",
      "defaultVisible": true,
      "binds": { "stars": "textReplacement", "color": "type colour" },
      "note": "Single-layer component: the stars variable is the row's whole content — one to three glyphs (★★★) or a short numeric value (4.5). maxChars 3 caps it."
    }
  ],
  "bindings": {
    "stars": { "layer": "Rating", "as": "textReplacement" },
    "color": { "layer": "Rating", "as": "type colour" }
  },
  "comps": {
    "default": "Accent glyphs #D96C3B.",
    "light": "Ink glyphs #3B2A20 on light hosts.",
    "dark": "Cream glyphs #FFF7EE on dark hosts."
  }
}
