{
  "id": "avatar-circle",
  "version": 1,
  "name": "Avatar Circle",
  "author": "studio",
  "description": "Circular avatar placeholder carrying up to three initials on a brand-coloured plate.",
  "tags": ["avatar", "profile", "ui"],
  "defaultSize": { "width": 96, "height": 96 },
  "variables": {
    "initials":  { "kind": "text", "default": "MC", "maxChars": 3 },
    "bg":        { "kind": "color", "default": "#D96C3B" },
    "textColor": { "kind": "color", "default": "#FFF7EE" }
  },
  "anchors": { "topLeft": [0, 0], "center": [0.5, 0.5], "bottomRight": [1, 1] },
  "comps": ["default", "light", "dark"],
  "license": "public"
}
