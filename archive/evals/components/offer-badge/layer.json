{
  "component": "offer-badge",
  "version": 2,
  "master": "offer-badge@2.pcraft",
  "designSize": { "width": 180, "height": 180 },
  "group": "Offer Badge",
  "layers": [
    {
      "name": "Badge background",
      "kind": "shape",
      "shape": "ellipse",
      "bounds": [0, 0, 180, 180],
      "fill": "#D96C3B",
      "defaultVisible": true,
      "binds": { "bg": "fill colour" }
    },
    {
      "name": "Ribbon",
      "kind": "shape",
      "shape": "rect",
      "bounds": [0, 148, 180, 32],
      "fill": "#3B2A20",
      "defaultVisible": false,
      "binds": { "showRibbon": "visibility" }
    },
    {
      "name": "Label",
      "kind": "text",
      "bounds": [16, 70, 148, 40],
      "font": "display",
      "weight": "bold",
      "size": 28,
      "lineHeight": 1.1,
      "align": "center",
      "color": "#FFF7EE",
      "defaultVisible": true,
      "binds": { "label": "textReplacement", "textColor": "type colour" }
    }
  ],
  "bindings": {
    "label":      { "layer": "Label", "as": "textReplacement" },
    "bg":         { "layer": "Badge background", "as": "fill colour" },
    "textColor":  { "layer": "Label", "as": "type colour" },
    "showRibbon": { "layer": "Ribbon", "as": "visibility" }
  },
  "comps": {
    "default": "Authored state: accent plate #D96C3B, cream label #FFF7EE, ink ribbon hidden unless showRibbon.",
    "light": "Paper plate #F4E7D3, ink label #3B2A20, accent ribbon #D96C3B.",
    "dark": "Ink plate #3B2A20, cream label #FFF7EE, accent ribbon #D96C3B."
  }
}
