{
  "component": "quote-block",
  "version": 1,
  "master": "quote-block@1.pcraft",
  "designSize": { "width": 640, "height": 320 },
  "group": "Quote Block",
  "layers": [
    {
      "name": "Accent rule",
      "kind": "shape",
      "shape": "rect",
      "bounds": [48, 28, 72, 6],
      "fill": "#D96C3B",
      "defaultVisible": true,
      "binds": { "accent": "fill colour" }
    },
    {
      "name": "Quote",
      "kind": "text",
      "bounds": [48, 56, 544, 168],
      "font": "display",
      "size": 32,
      "lineHeight": 1.3,
      "align": "start",
      "maxLines": 5,
      "color": "#3B2A20",
      "defaultVisible": true,
      "binds": { "quote": "textReplacement" },
      "note": "maxChars 280 with maxLines 5 and layout.fitText minSize 24 keeps the block inside its box (§9.3)."
    },
    {
      "name": "Author",
      "kind": "text",
      "bounds": [48, 240, 544, 36],
      "font": "sans",
      "weight": "bold",
      "size": 20,
      "lineHeight": 1.2,
      "align": "start",
      "color": "#6B5748",
      "defaultVisible": true,
      "binds": { "author": "textReplacement" }
    }
  ],
  "bindings": {
    "quote":  { "layer": "Quote", "as": "textReplacement" },
    "author": { "layer": "Author", "as": "textReplacement" },
    "accent": { "layer": "Accent rule", "as": "fill colour" }
  },
  "comps": {
    "default": "Ink quote #3B2A20, muted author #6B5748, accent rule.",
    "light": "For paper backgrounds: as authored, rule accent #D96C3B.",
    "dark": "For dark hosts: cream quote and author #FFF7EE, accent rule #D96C3B."
  }
}
