{
  "id": "wave-divider",
  "version": 1,
  "name": "Wave Divider",
  "author": "studio",
  "description": "Section divider: a primary wave crest with an optional mirrored crest that closes the band.",
  "tags": ["divider", "decoration"],
  "defaultSize": { "width": 600, "height": 80 },
