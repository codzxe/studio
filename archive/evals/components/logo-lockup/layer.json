{
  "component": "logo-lockup",
  "version": 1,
  "master": "logo-lockup@1.pcraft",
  "designSize": { "width": 320, "height": 96 },
  "group": "Logo Lockup",
  "layers": [
    {
      "name": "Halo",
      "kind": "shape",
      "shape": "roundedRect",
      "radius": 16,
      "bounds": [0, 0, 320, 96],
      "fill": "#FFF7EE",
      "defaultVisible": false,
      "binds": { "onDark": "visibility" },
      "note": "Knockout plate behind the lockup so the mark keeps >= 3:1 contrast (§11.1) on dark or photographic hosts."
    },
    {
      "name": "Logo mark",
      "kind": "shape",
      "shape": "ellipse",
      "bounds": [0, 8, 80, 80],
      "fill": "#D96C3B",
      "defaultVisible": true,
      "binds": { "color": "fill colour" }
    },
    {
      "name": "Logo name",
      "kind": "text",
      "bounds": [96, 16, 224, 36],
      "font": "display",
      "weight": "bold",
      "size": 32,
      "lineHeight": 1.1,
      "align": "start",
      "color": "#3B2A20",
      "defaultVisible": true,
      "binds": { "name": "textReplacement" }
    },
    {
      "name": "Logo tagline",
      "kind": "text",
      "bounds": [96, 56, 224, 24],
      "font": "sans",
      "size": 18,
      "lineHeight": 1.2,
      "align": "start",
      "color": "#6B5748",
      "defaultVisible": true,
      "binds": { "tagline": "textReplacement" },
      "note": "Optional line: the manifest default is the empty string, so the layer is present but blank until tagline is set (§7.3 present-but-hidden). Hide it via a comp when unused."
    }
  ],
  "bindings": {
    "name":    { "layer": "Logo name", "as": "textReplacement" },
    "tagline": { "layer": "Logo tagline", "as": "textReplacement" },
    "color":   { "layer": "Logo mark", "as": "fill colour" },
    "onDark":  { "layer": "Halo", "as": "visibility" }
  },
  "comps": {
    "default": "Ink name #3B2A20, muted tagline #6B5748, accent mark, halo hidden.",
    "light": "For paper backgrounds: ink name and mark as authored, tagline ink #3B2A20, halo cream #FFF7EE.",
    "dark": "For dark hosts: cream name and tagline #FFF7EE, cream mark, halo ink #3B2A20."
  }
}
