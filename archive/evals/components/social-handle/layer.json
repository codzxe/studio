{
  "component": "social-handle",
  "version": 1,
  "master": "social-handle@1.pcraft",
  "designSize": { "width": 280, "height": 48 },
  "group": "Social Handle",
  "layers": [
    {
      "name": "Icon",
      "kind": "shape",
      "shape": "ellipse",
      "bounds": [8, 8, 32, 32],
      "fill": "#3B2A20",
      "defaultVisible": true,
      "binds": { "showIcon": "visibility" },
      "note": "Abstract dot icon in the fixed workspace ink so it stays legible when the handle is recoloured; comps restyle it. showIcon=false hides it (§7.3 present-but-hidden); the handle keeps its slot — nudge it via a comp."
    },
    {
      "name": "Handle",
      "kind": "text",
      "bounds": [56, 10, 216, 28],
      "font": "sans",
      "weight": "bold",
      "size": 22,
      "lineHeight": 1.1,
      "align": "start",
      "color": "#3B2A20",
      "defaultVisible": true,
      "binds": { "handle": "textReplacement", "color": "type colour" }
    }
  ],
  "bindings": {
    "handle":   { "layer": "Handle", "as": "textReplacement" },
    "color":    { "layer": "Handle", "as": "type colour" },
    "showIcon": { "layer": "Icon", "as": "visibility" }
  },
  "comps": {
    "default": "Ink handle and icon #3B2A20.",
    "light": "For paper backgrounds: as authored.",
    "dark": "For dark hosts: cream handle and icon #FFF7EE."
  }
}
