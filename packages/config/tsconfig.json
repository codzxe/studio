{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Fleet normalization: no rootDir/outDir; tests sit next to src/ and the program
    // resolves sibling workspace sources via imports. `tsc --noEmit` is the gate.
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
