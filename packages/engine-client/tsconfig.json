{
    "extends": "../../tsconfig.base.json",
    // Fleet normalization (W2-Q): NO explicit rootDir. tests/ sit next to src/
    // and this package's program pulls sibling workspace SOURCES via imports
    // (@studio/config resolves to src/*.ts through pnpm links), so an explicit
    // rootDir — "src" or "." — would trip TS6059 on those files. tsc infers the
    // common root; `tsc --noEmit` is the gate.
    "compilerOptions": { "outDir": "dist", "jsx": "preserve" },
    "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"]
  }
