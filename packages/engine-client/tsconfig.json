{
    "extends": "../../tsconfig.base.json",
    // No explicit rootDir: tests/ sits next to src/ and tsc would otherwise report
    // TS6059 ("file is not under rootDir") while typechecking (same call as the
    // tools, worker and engine-pool packages).
    "compilerOptions": { "outDir": "dist", "jsx": "preserve" },
    "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"]
  }
