{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No rootDir/outDir: tests/ sits next to src/ and `tsc --noEmit` is the gate
    // (fleet precedent — packages/billing, packages/tools; avoids the TS6059 trap).
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
