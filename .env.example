# =============================================================================
# .env.example — the CANONICAL environment matrix for the whole SaaS (ADR 0002)
# =============================================================================
# Copy to `.env` for local runs (infra/compose reads it; keep it chmod 0600).
# Real values NEVER go in this file — placeholders are `changeme` / `localhost`.
#
# RULES (spec §4 conventions + §15.2 app security):
#   * Every variable is parsed and typed ONCE in `packages/config` (Zod schema
#     at the env boundary). App code never reads `process.env` directly.
#   * A REQUIRED secret that is missing (or still `changeme`) makes the
#     process REFUSE TO START — fail fast, §4: "missing var = process refuses
#     to start". Secrets are NEVER given silent defaults.
#   * Secrets live only in env files / the secret store — never in the repo,
#     never in logs (§15.2). Separate keys per environment (§17.5).
#
# Environments (§17.5): APP_ENV = local | staging | production.
# Staging runs on the same box with its own Compose project, subdomain and DB,
# and uses Stripe TEST keys. Never test migrations on production first.
# =============================================================================

# -----------------------------------------------------------------------------
# Core / shared (all apps)
# -----------------------------------------------------------------------------

# Deployment environment: local | staging | production (§17.5) — selects feature-flag defaults, CORS and logging.
APP_ENV=local
# Runtime mode for frameworks (development | test | production); derived from APP_ENV but settable for tooling.
NODE_ENV=development
# Public URL of the web app; also the CORS allowlist origin (§15.2 — allowlist only the app domain, never *).
PUBLIC_WEB_URL=http://localhost:3000
# Log level floor: trace | debug | info | warn | error (§22 — prompts are redacted unless the workspace opts in).
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Gateway (apps/gateway — Hono REST + SSE + webhooks, spec §13)
# -----------------------------------------------------------------------------

# Port the gateway listens on (behind Caddy in staging/prod; direct for local).
GATEWAY_PORT=8787
# Better Auth session/cookie signing key (REQUIRED) — 32+ random bytes, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=changeme
# Base URL where Better Auth handlers are mounted (OAuth / magic-link callbacks resolve against it).
BETTER_AUTH_URL=http://localhost:8787

# --- Upload caps (gateway registers assets; §15.2 hard caps) ------------------

# Max upload size per file in bytes (default 25 MB per image, §15.2).
UPLOAD_MAX_FILE_BYTES=26214400
# Max files registered per upload request (§15.2 — reject bulk floods).
UPLOAD_MAX_FILES_PER_REQUEST=10

# --- Rate limits (§15.2: per IP / user / workspace on auth, uploads, runs, exports) ---

# Auth attempts (sign-in, magic-link, OAuth) per IP per minute.
RATE_LIMIT_AUTH_PER_MINUTE=10
# Agent runs created per workspace per minute (concurrency caps are plan-level, §14.1).
RATE_LIMIT_RUNS_PER_MINUTE_PER_WORKSPACE=6
# Uploads accepted per user per hour.
RATE_LIMIT_UPLOADS_PER_HOUR_PER_USER=20
# Exports started per workspace per minute.
RATE_LIMIT_EXPORTS_PER_MINUTE_PER_WORKSPACE=10

# --- SSE (§13.1–13.2: backfill from run_events, then live; resume via Last-Event-ID) ---

# Milliseconds between SSE keep-alive heartbeats on GET /v1/runs/:id/events.
SSE_HEARTBEAT_INTERVAL_MS=15000
# Max events replayed from run_events when a stream connects (backfill before going live).
SSE_BACKFILL_MAX_EVENTS=1000
# How long after a disconnect a client may resume the same stream via Last-Event-ID (§13.2).
SSE_RESUME_WINDOW_MS=300000

# -----------------------------------------------------------------------------
# Worker (apps/worker — BullMQ: agent loop, critic, exports)
# -----------------------------------------------------------------------------

# Concurrent BullMQ jobs per worker process (agent loop, exports; 2-CPU box — keep small).
WORKER_CONCURRENCY=2
# Max attempts for a plain job before it parks in the failed set (agent RUNS are not retried blind — §5.1).
WORKER_MAX_JOB_ATTEMPTS=3
# Daily workspace credit cap as a multiple of the plan's monthly credits (§14.2 rule 7 — runaway-loop stop; alert at 80%).
BILLING_DAILY_CAP_MULTIPLIER=2
# Retention window in days for agent steps / prompts / renders; range 30–365 per plan (§15.3).
RETENTION_AGENT_STEPS_DAYS=90

# -----------------------------------------------------------------------------
# Engine pool (apps/engine-pool — one engine process per tenant session, §15.1)
# -----------------------------------------------------------------------------

# Absolute path to the pinned engine binary (`photocraft-cli`, shallow vendor clone — ADR 0001); the compose image bakes its own copy.
ENGINE_CLI_PATH=/home/z/my-project/vendor/photocraft/target/release/photocraft-cli
# Host engine processes bind to; NEVER 0.0.0.0 — no engine port exposure beyond localhost / private net (§15.1).
ENGINE_BIND_HOST=127.0.0.1
# Root directory holding per-session working dirs (capability roots are scoped under it, §15.1).
ENGINE_WORK_DIR=/home/z/my-project/studio/.local/engine-work
# Warm engine sessions kept alive to shave start latency (0 = cold start per run).
ENGINE_POOL_MIN_IDLE_SESSIONS=0
# Max concurrent engine sessions on this box (§15.1 quota isolation; start small, scale per §17.4 triggers).
ENGINE_POOL_MAX_SESSIONS=4
# Reap a session idle (no client command) longer than this many seconds.
ENGINE_SESSION_IDLE_TIMEOUT_SECS=600
# Hard lifetime cap per engine session; sessions are recycled to bound leaks.
ENGINE_SESSION_MAX_LIFETIME_SECS=7200
# CPU shares per engine session (1.0 = one core) — noisy-neighbour cap (§15.1).
ENGINE_SESSION_CPU_LIMIT=0.5
# Memory cap in MB per engine session; the pool kills sessions before the box starves (§17.4).
ENGINE_SESSION_MEMORY_LIMIT_MB=1024
# Timeout for one engine control-protocol command; tool wrappers default to 5 s and may extend it (§6).
ENGINE_COMMAND_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Web (apps/web — Next.js marketing + product UI)
# -----------------------------------------------------------------------------

# Port the Next.js server listens on (local only; Cloudflare Pages in staging/prod, §17.1).
WEB_PORT=3000
# Browser-visible app URL (Next.js public env — safe to bundle client-side).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Browser-visible gateway base (versioned API under /v1 — §13).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787/v1

# -----------------------------------------------------------------------------
# Infra — Postgres (§12 data model, Drizzle)
# -----------------------------------------------------------------------------

# Connection string (REQUIRED) — postgres://user:password@host:5432/database.
DATABASE_URL=postgres://studio:changeme@localhost:5432/studio
# Max pooled connections per app process (gateway + worker share the box's Postgres).
DATABASE_POOL_MAX=10
# Require TLS to Postgres: false locally, true against a managed instance in production.
DATABASE_SSL=false

# -----------------------------------------------------------------------------
# Infra — Valkey (BullMQ queues, rate-limit counters, SSE presence)
# -----------------------------------------------------------------------------

# Valkey connection URL (REQUIRED) — Valkey, NOT Redis 7.4+ (license policy §16.5).
VALKEY_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Infra — Object storage (AWS S3 in prod; Cloudflare R2 or MinIO locally, §17.1)
# -----------------------------------------------------------------------------

# S3-compatible endpoint (AWS: https://s3.<region>.amazonaws.com; R2/MinIO: custom).
S3_ENDPOINT=http://localhost:9000
# Bucket region ("auto" for R2 / MinIO).
S3_REGION=auto
# Assets bucket — keys are workspace/<workspace_id>/<document_id>/… (§15.1 prefixes).
S3_BUCKET=changeme-assets
# Versioned backups bucket (pg_dump target, §17.1 backups row).
S3_BACKUP_BUCKET=changeme-backups
# Access key id (REQUIRED).
S3_ACCESS_KEY_ID=changeme
# Secret access key (REQUIRED).
S3_SECRET_ACCESS_KEY=changeme
# Signed-URL lifetime in seconds; MUST stay ≤ 900 (15 min, §15.1 — short-lived URLs, no public buckets).
S3_SIGNED_URL_TTL_SECS=900
# Path-style addressing (true for MinIO / R2, typically false for AWS S3).
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Infra — Stripe (§14 credits, plans and billing)
# -----------------------------------------------------------------------------

# Secret API key (REQUIRED) — sk_test_* for local / staging (§17.5), sk_live_* for production.
STRIPE_SECRET_KEY=changeme
# Webhook signing secret (REQUIRED) — signature verification is mandatory and idempotent by event id (§15.2, §14.3).
STRIPE_WEBHOOK_SECRET=changeme
# Recurring price id — $30/mo plan → 100 credits (§14.1).
STRIPE_PRICE_PLAN_100_CREDITS=changeme
# Recurring price id — $60/mo plan → 250 credits (§14.1).
STRIPE_PRICE_PLAN_250_CREDITS=changeme
# Recurring price id — $120/mo plan → 600 credits (§14.1).
STRIPE_PRICE_PLAN_600_CREDITS=changeme
# One-time price id — credit pack: $10 → 100 credits (§14.1).
STRIPE_PRICE_CREDIT_PACK_100=changeme
# Recurring price id — additional seat: +$8/mo (§14.1).
STRIPE_PRICE_EXTRA_SEAT=changeme

# -----------------------------------------------------------------------------
# Infra — Model providers (routing table §5.3)
# -----------------------------------------------------------------------------
# PAID-ONLY: customer content must NEVER flow through free / training LLM tiers
# (§1.5 constraint 6) — free tiers train on data, so using one fails the rule.
# No OpenRouter in production. Request `store:false` / no-training flags where
# the provider offers them (§15.3). Provider keys are REQUIRED before the first
# run executes; circuit breakers fail over to the alternate same-class provider
# (§5.3, §17.4).
# -----------------------------------------------------------------------------

# Google Vertex AI project id — Gemini 3.8 Flash is the default planner / executor / critic (§5.3).
GOOGLE_VERTEX_PROJECT=changeme
# Vertex region serving Gemini models (us-central1; europe-west1 for EU-region customers, §15.4).
GOOGLE_VERTEX_REGION=us-central1
# Service-account email for Vertex auth (Workload Identity is the prod path; this is local/staging).
GOOGLE_VERTEX_CLIENT_EMAIL=changeme@changeme.iam.gserviceaccount.com
# Service-account private key (REQUIRED) — multi-line PEM kept as one quoted value.
GOOGLE_VERTEX_PRIVATE_KEY="changeme"
# Anthropic key — Claude Sonnet 5.5 (premium tier) and Opus 5.5 (max tier) (§5.3).
ANTHROPIC_API_KEY=changeme
# OpenAI key — GPT Image 1.5 HD for max-tier image finals (§5.3).
OPENAI_API_KEY=changeme
# DeepSeek key — economy planner / executor incl. off-peak batch endpoints (§5.3); PAID tier only.
DEEPSEEK_API_KEY=changeme
# Base URL of the paid image-drafts host serving Flux 2 Schnell (§5.3).
FLUX_API_BASE_URL=changeme
# API key for the image-drafts host (Flux 2 Schnell drafts; Gemini 3 Pro Image finals reuse the Vertex creds above).
FLUX_API_KEY=changeme
# Per-request timeout in ms for any model or image-provider call.
AI_REQUEST_TIMEOUT_MS=60000
# Retries per provider before the circuit breaker fails over to the alternate same-class provider (§5.3).
AI_PROVIDER_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Infra — Fonts (§1.5 rule 9)
# -----------------------------------------------------------------------------

# Root of the pinned craft-fonts clone (ADR 0001); fonts are read from here at
# build / render time and font files are NEVER committed to this repo.
CRAFT_FONTS_DIR=/home/z/my-project/vendor/craft-fonts

# -----------------------------------------------------------------------------
# Observability (§22)
# -----------------------------------------------------------------------------

# OTLP HTTP endpoint for OpenTelemetry traces / metrics (collector on the box; spans: HTTP → queue → worker → tool → engine).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTLP wire protocol (http/protobuf keeps the box agentless and light).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Sampling floor for successful traces (§22: 100% of errors, ~10% of successes; errors are always kept).
OTEL_TRACES_SAMPLING_RATE=0.1
# GlitchTip DSN — Sentry-compatible error ingestion (free cloud tier or self-host on-box, §17.1).
GLITCHTIP_DSN=changeme
# Langfuse public key — LLM traces: model, tokens, cost, cache hit, verdicts (§22).
LANGFUSE_PUBLIC_KEY=changeme-pk
# Langfuse secret key (REQUIRED when Langfuse tracing is enabled; masked prompts until self-hosted, §17.2).
LANGFUSE_SECRET_KEY=changeme-sk
# Langfuse base URL — free cloud tier first; self-host after ~100 users or a privacy requirement (§17.2).
LANGFUSE_BASE_URL=changeme

# -----------------------------------------------------------------------------
# Email — transactional only: invites, receipts, run finished (§17.1)
# -----------------------------------------------------------------------------

# Resend API key (swap to Amazon SES via a provider adapter if volume grows).
RESEND_API_KEY=changeme
# Verified sender address shown to users in transactional mail.
EMAIL_FROM_ADDRESS=no-reply@changeme.example
