# ===========================================================================
# Studio environment template — GENERATED FILE, do not edit by hand.
#
# Source of truth : packages/config/src/env.ts (ENV_VAR_SPECS — 34 vars).
# Regenerate       : pnpm dev:env   (scripts/gen-env.sh → scripts/gen-env.ts)
#
# Copy to .env for local runs:   cp .env.example .env && chmod 600 .env
# Startup fails fast on the FIRST invalid environment (EnvFatalError lists
# every missing/invalid/rejected var with its purpose; secret VALUES are
# never echoed). Blank values count as unset — schema defaults then apply.
#
# Secrets: never commit real values; every row marked “Secret — never commit”
# must come from your shell, .env (chmod 0600) or a secret manager.
#
# Local defaults below assume the native dev services (no Docker, no sudo):
#   pnpm dev:pg                        # PostgreSQL 17 @ 127.0.0.1:5432
#   bash scripts/dev-valkey.sh start  # Valkey 8 @ 127.0.0.1:6379 (optional)
#   bash scripts/dev-litellm.sh start  # LiteLLM proxy @ 127.0.0.1:4000 (Docker boxes; optional)
#   pnpm editor:serve                 # editor dev server @ 127.0.0.1:8765
# ===========================================================================

# ── app ──
# APP_URL — Public origin of the web app — auth redirects, OAuth callbacks, signed URLs, CORS.
# Required.
APP_URL=http://localhost:3000

# APP_ENV — Deployment environment (local, staging, production); gates dev-only flags and billing requirements.
# Required.
APP_ENV=local

# LOG_LEVEL — Verbosity of structured logs (debug, info, warn, error).
# Default: info.
LOG_LEVEL=info

# MOCK_MODEL — Offline mock model provider for local development and tests.
# Default: false.
# Rejected when APP_ENV is "production" — it would bypass real model routing and billing.
MOCK_MODEL=false

# ── db ──
# DATABASE_URL — Control-plane database URL (auth, projects, versions, runs, credits): Postgres (postgres:// or postgresql://) in staging/production and for the full DB-gated test suite, or — local dev only — a SQLite file URL (file:.local/studio-dev.db, maintained by pnpm dev:sqlite) for a PG-free dev server.
# Required. Secret — never commit.
# SQLite URLs (file:… or sqlite:…) are accepted only when APP_ENV is "local" — rejected in staging and production, where a PostgreSQL URL is required.
# Local default: `pnpm dev:pg` starts portable PostgreSQL 17 at 127.0.0.1:5432
# (user `studio`, password `studio`, database `studio`).
# PG-free alternative: `pnpm dev:sqlite` maintains a SQLite file instead —
# set DATABASE_URL=file:.local/studio-dev.db (APP_ENV=local only; rejected
# in staging/production, which always require the PostgreSQL URL).
DATABASE_URL=postgres://studio:studio@127.0.0.1:5432/studio

# ── queue ──
# VALKEY_URL — Valkey (Redis protocol) URL for job queues and rate limits.
# Optional. Secret — never commit.
# Optional — queues and rate limits degrade gracefully when unset.
# Local default: `scripts/dev-valkey.sh start` starts Valkey 8 at 127.0.0.1:6379.
# To disable locally, set it blank (VALKEY_URL=) or comment the line out.
VALKEY_URL=redis://127.0.0.1:6379

# ── storage ──
# S3_ENDPOINT — S3-compatible object-storage endpoint (MinIO locally, S3/R2 in the cloud). Optional in local: the gateway falls back to a filesystem driver under .local/storage.
# Optional.
# Local default: BLANK → the gateway's filesystem driver stores objects
# under the repo (`.local/storage/`) — no MinIO needed for local dev.
# Real object storage: set a MinIO/S3/R2 endpoint, e.g. http://127.0.0.1:9000
# (compose: the `minio` service) and fill S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY.
S3_ENDPOINT=

# S3_REGION — Object-storage region ('auto' for MinIO/R2). Optional in local with the filesystem driver.
# Optional.
S3_REGION=auto

# S3_ACCESS_KEY_ID — Object-storage access key id. Optional in local with the filesystem driver.
# Optional. Secret — never commit.
S3_ACCESS_KEY_ID=minioadmin

# S3_SECRET_ACCESS_KEY — Object-storage secret access key. Optional in local with the filesystem driver.
# Optional. Secret — never commit.
S3_SECRET_ACCESS_KEY=minioadmin

# S3_BUCKET — Bucket for project versions, assets, renders and previews. Optional in local with the filesystem driver.
# Optional.
S3_BUCKET=studio-local

# ASSET_MAX_BYTES — Hard cap on a single uploaded asset, in bytes.
# Required.
ASSET_MAX_BYTES=524288000

# PROJECT_MAX_BYTES — Hard cap on a serialized .ecproj project snapshot, in bytes.
# Required.
PROJECT_MAX_BYTES=262144000

# ── stripe ──
# STRIPE_SECRET_KEY — Stripe API secret key (sk_test_… / sk_live_…).
# Optional. Secret — never commit.
# Required when APP_ENV is "staging" or "production"; optional in "local".
STRIPE_SECRET_KEY=sk_test_replace_me

# STRIPE_WEBHOOK_SECRET — Stripe webhook signing secret (whsec_…) for POST /v1/webhooks/stripe.
# Required. Secret — never commit.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# STRIPE_PRICE_IDS — JSON map of billing plan to Stripe price id, e.g. {"starter":"price_…"}.
# Required.
STRIPE_PRICE_IDS={"starter":"price_starter","pro":"price_pro","studio":"price_studio"}

# ── auth ──
# AUTH_SECRET — Better Auth session/token signing secret; at least 32 chars (openssl rand -base64 32).
# Required. Secret — never commit.
# Local default: INSTRUCTIONS, never a literal secret in this template.
#   Generate one and paste it into your .env:   openssl rand -base64 32
#   (the generator prints a fresh suggestion to the terminal each run)
AUTH_SECRET=replace-with-openssl-rand-base64-32

# AUTH_GOOGLE_ID — Google OAuth client id for sign-in.
# Required.
AUTH_GOOGLE_ID=replace-me.apps.googleusercontent.com

# AUTH_GOOGLE_SECRET — Google OAuth client secret.
# Required. Secret — never commit.
AUTH_GOOGLE_SECRET=replace-me

# AUTH_GITHUB_ID — GitHub OAuth app id for sign-in.
# Required.
AUTH_GITHUB_ID=replace-me

# AUTH_GITHUB_SECRET — GitHub OAuth app secret.
# Required. Secret — never commit.
AUTH_GITHUB_SECRET=replace-me

# ── litellm ──
# LITELLM_BASE_URL — OpenAI-compatible LiteLLM gateway base URL (serves the studio-fast/smart/vision aliases).
# Required.
# Local default: LiteLLM proxy on loopback — `bash scripts/dev-litellm.sh`
# (repo-root docker-compose.litellm.yml), a venv (`litellm --config deploy/litellm/config.yaml`)
# or the infra/compose `litellm` service. Runbook: docs/deploy/LITELLM.md.
LITELLM_BASE_URL=http://127.0.0.1:4000

# LITELLM_API_KEY — Platform key for the LiteLLM gateway.
# Required. Secret — never commit.
LITELLM_API_KEY=sk-litellm-replace-me

# LITELLM_VIRTUAL_KEY — LiteLLM virtual key for per-tenant budgets and spend logs.
# Optional. Secret — never commit.
# Optional in v1 — platform keys only.
LITELLM_VIRTUAL_KEY=sk-virtual-replace-me

# LITELLM_MODEL_MAP — JSON alias→provider-model-id map for direct OpenAI-compatible providers (unset = aliases pass through to the LiteLLM proxy).
# Optional.
# Optional — set only when the gateway talks to a provider directly instead of a LiteLLM proxy.
# Direct OpenAI-compatible provider (no LiteLLM proxy): point LITELLM_BASE_URL
# at the hosted gateway and map the studio aliases to provider model ids.
# Unset (the default) = aliases pass through to the proxy unchanged.
# Token Harbor free-tier example — free variants of paid models need the
# provider's `:free` suffix (bare ids route to the PAID model and 402 on a
# zero balance); tool names are sanitized on the wire automatically:
#   LITELLM_MODEL_MAP={"studio-fast":"deepseek-v4.1-flash:free","studio-smart":"th-rudder","studio-vision":"th-rudder"}
LITELLM_MODEL_MAP={"studio-fast":"provider-fast-model","studio-smart":"provider-smart-model"}

# ── editor ──
# EDITOR_PUBLIC_PATH — Path the frozen editor build is served at (same-origin iframe mount).
# Default: /editor.
EDITOR_PUBLIC_PATH=/editor

# EDITOR_DEV_SERVER_URL — Dev-only URL of the cargo xtask web server proxied at the editor path.
# Optional.
# Dev only — rejected when APP_ENV is "production".
# Local default: `cargo xtask web --serve 8765` from editor/, proxied under the editor path.
EDITOR_DEV_SERVER_URL=http://127.0.0.1:8765

# EDITOR_WASM_MAX_MB — Compressed wasm size budget in MB, enforced at serving time and in CI.
# Default: 18.
EDITOR_WASM_MAX_MB=18

# ── agent ──
# CHAT_MAX_STEPS — Maximum model/tool steps allowed in one chat run.
# Required.
CHAT_MAX_STEPS=50

# AGENT_BATCH_MAX_STEPS — Maximum commands in one engine.batch (applied atomically).
# Default: 100.
AGENT_BATCH_MAX_STEPS=100

# AGENT_BATCH_MAX_BYTES — Maximum serialized size of one engine.batch, in bytes.
# Default: 2097152.
AGENT_BATCH_MAX_BYTES=2097152

# AGENT_BATCH_TIMEOUT_MS — Execution timeout for one engine.batch, in milliseconds.
# Default: 60000.
AGENT_BATCH_TIMEOUT_MS=60000

# ── lease ──
# LEASE_HEARTBEAT_MS — Single-writer lease heartbeat interval (2 minutes by default).
# Default: 120000.
LEASE_HEARTBEAT_MS=120000

# LEASE_TTL_MS — Single-writer lease expiry (5 minutes by default); must exceed the heartbeat.
# Default: 300000.
LEASE_TTL_MS=300000

# ── render ──
# EFFECTCRAFT_CLI_PATH — Absolute path to the effectcraft-cli binary the render worker spawns. Resolution order: this value, else <repo>/editor/target/release/effectcraft-cli if present, else a PATH lookup.
# Optional.
# Optional and never a secret — blank resolves to the repo-local release build, then PATH.
EFFECTCRAFT_CLI_PATH=

# RENDER_WORKER_ENABLED — Feature flag for the M8 render worker: when false, no render jobs are dequeued (queued jobs persist).
# Default: true.
RENDER_WORKER_ENABLED=true

# RENDER_WORKER_CONCURRENCY — Simultaneous render jobs one worker process runs (per instance).
# Default: 2.
RENDER_WORKER_CONCURRENCY=2

# RENDER_JOB_TIMEOUT_SECONDS — Hard timeout for one render job, in seconds; a job that exceeds it fails with RENDER_TIMEOUT.
# Default: 1800.
RENDER_JOB_TIMEOUT_SECONDS=1800

# RENDER_MAX_ATTEMPTS — Maximum attempts (initial run plus retries) for one render job before it fails.
# Default: 2.
RENDER_MAX_ATTEMPTS=2

# RENDER_HEARTBEAT_STALE_SECONDS — A running render job whose heartbeat is older than this many seconds is considered crashed and is reclaimed for retry.
# Default: 120.
RENDER_HEARTBEAT_STALE_SECONDS=120

# RENDER_POLL_INTERVAL_MS — How often an idle render worker polls the job queue, in milliseconds.
# Default: 1000.
RENDER_POLL_INTERVAL_MS=1000

# ── obs ──
# OTEL_EXPORTER_OTLP_ENDPOINT — OpenTelemetry OTLP endpoint for traces and metrics.
# Optional.
# Optional — telemetry is disabled when unset.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318


