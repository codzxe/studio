{
  // mock-engine is a zero-dependency Node stdlib package (plain .mjs, run with
  // bare `node`, checked with `node --test`). This tsconfig exists only for the
  // fleet convention (W2-Q): every workspace package extends the base; the JS
  // sources stay untyped (checkJs off).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.mjs", "tests/**/*.mjs"]
}
