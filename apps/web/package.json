{
  "name": "@studio/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Studio web app \u2014 Next.js marketing site, auth pages and (later) the SaaS shell (docs/UI_DESIGN_SYSTEM.md \u00a78)",
  "scripts": {
    "dev": "next dev",
    "build": "node ../../scripts/fetch-web-fonts.mjs && esbuild --bundle api-src/gateway.ts --tsconfig=api-src/tsconfig.json --platform=node --format=esm --target=node22 --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);\" --outfile=api/gateway.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "@studio/api-client": "workspace:*",
    "@studio/config": "workspace:*",
    "@studio/contracts": "workspace:*",
    "@studio/editor-bridge": "workspace:*",
    "@studio/ui": "workspace:*",
    "better-auth": "^1.7.12",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "esbuild": "^0.28.2"
  }
}
